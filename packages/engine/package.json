{
  "name": "@svelte-pdf/engine",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Framework-agnostic PDF engine for svelte-pdf (layout, render, pdfkit, font, text, styles)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives.js"
    },
    "./fns": {
      "types": "./dist/fns/index.d.ts",
      "default": "./dist/fns.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "default": "./dist/svg.js"
    },
    "./pdfkit": {
      "types": "./dist/pdfkit/document.node.d.ts",
      "default": "./dist/pdfkit.js"
    },
    "./pdfkit/standard-fonts/*": {
      "types": "./dist/pdfkit/standard-fonts/*.d.ts",
      "default": "./dist/pdfkit/standard-fonts/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./font": {
      "types": "./dist/font/index.d.ts",
      "default": "./dist/font.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "default": "./dist/image.js"
    },
    "./textkit": {
      "types": "./dist/textkit/index.d.ts",
      "default": "./dist/textkit.js"
    },
    "./stylesheet": {
      "types": "./dist/stylesheet/index.d.ts",
      "default": "./dist/stylesheet.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && cp -R src/types dist/types",
    "build:clean": "rm -rf dist && rollup -c && cp -R src/types dist/types",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13",
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.6.0",
    "abs-svg-path": "^0.1.1",
    "browserify-zlib": "^0.2.0",
    "bidi-js": "^1.0.2",
    "color-string": "^2.1.4",
    "emoji-regex-xs": "^1.0.0",
    "fontkit": "^2.0.2",
    "hsl-to-hex": "^1.0.0",
    "hyphen": "^1.6.4",
    "is-url": "^1.2.4",
    "jay-peg": "^1.1.1",
    "js-md5": "^0.8.3",
    "linebreak": "^1.1.0",
    "media-engine": "^1.0.3",
    "normalize-svg-path": "^1.1.0",
    "pako": "^1.0.11",
    "parse-svg-path": "^0.1.2",
    "png-js": "^2.0.0",
    "postcss-value-parser": "^4.1.0",
    "queue": "^6.0.1",
    "svg-arc-to-cubic-bezier": "^3.2.0",
    "unicode-properties": "^1.4.1",
    "vite-compatible-readable-stream": "^3.6.1",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/fontkit": "^2.0.7",
    "@types/is-url": "^1.2.32",
    "rollup-plugin-delete": "^3.0.2",
    "tslib": "^2.8.1",
    "typescript": "5.8.3",
    "vitest": "^1.2.0"
  }
}
