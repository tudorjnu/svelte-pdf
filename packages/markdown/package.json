{
  "name": "@svelte-pdf/markdown",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Markdown to PDF component for svelte-pdf",
  "type": "module",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c && cp src/index.d.ts dist/index.d.ts",
    "build:clean": "rm -rf dist && bun run build",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@svelte-pdf/renderer": "0.1.2",
    "marked": "^12.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "jest-image-snapshot": "^6.5.2",
    "rollup": "^4.62.4",
    "svelte": "^5.56.8",
    "vitest": "^1.2.0"
  }
}
